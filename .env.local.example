# Email Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Email Address
# This is where contact form submissions will be sent
ADMIN_EMAIL=your-email@example.com

# Rate Limiting Configuration
# Time window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=5

# Chatbot - Groq API
# Get your API key from https://console.groq.com/keys
# Required for AI chat functionality
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chatbot - Tavily Web Search
# Get your API key from https://tavily.com
# Optional: Enables web search in chatbot for current events/news
TAVILY_API_KEY=tvly_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Integration
# Get your API key from https://www.notion.so/my-integrations
NOTION_SECRET=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database IDs
NOTION_EXPERIENCE_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PROJECTS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_EDUCATION_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_CERTIFICATIONS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Node Environment
NODE_ENV=production
