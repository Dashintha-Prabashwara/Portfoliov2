# Email Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address for Resend, for example contact@dashijay.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# Admin Email Address
# This is where contact form submissions will be sent
ADMIN_EMAIL=your-email@example.com

# Rate Limiting Configuration
# Time window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=5

# Chatbot - Google Gemini API
# Get your API key from https://aistudio.google.com/apikey
# Required for AI chat functionality
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Chatbot - Tavily Web Search
# Get your API key from https://tavily.com
# Optional: Enables web search in chatbot for current events/news
TAVILY_API_KEY=tvly_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB Configuration
# Get your connection string from MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# CMS Admin Security
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_AUTH_SECRET=your_random_secret_token_key_here

# Node Environment
NODE_ENV=production
